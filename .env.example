# Скопируйте в .env на сервере и заполните. .env НЕ коммитится.
# Пароли/ключи сгенерировать: openssl rand -hex 24

# --- Домены (прод) ---
SITE_ADDR=ahnut.ru
# www + ахнуть.рф в punycode — редирект на основной
REDIRECT_ADDRS=www.ahnut.ru, xn--80a0apdi9b.xn--p1ai, www.xn--80a0apdi9b.xn--p1ai
N8N_HOST=n8n.ahnut.ru
PUBLIC_BASE_URL=https://ahnut.ru
ACME_EMAIL=your-email@example.com

# --- Локальный запуск без доменов (раскомментировать вместо блока выше) ---
# SITE_ADDR=http://localhost
# REDIRECT_ADDRS=http://127.0.0.1
# N8N_HOST=n8n.localhost
# N8N_PROTOCOL=http
# N8N_SECURE_COOKIE=false
# PUBLIC_BASE_URL=http://localhost

# --- Postgres ---
DB_USER=ahnut
DB_PASSWORD=change-me
DB_NAME=ahnut
N8N_DB_PASSWORD=change-me-too

# --- n8n: ключ шифрования сохранённых credentials. Потеряете — пересоздавать все ключи в n8n ---
N8N_ENCRYPTION_KEY=change-me-long-random

# --- ЮKassa (ЛК → Интеграция → Ключи API). Уведомления: https://ahnut.ru/yookassa/webhook,
#     события payment.succeeded, payment.canceled, refund.succeeded ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Письма через UniOne (как во втором проекте): домен ahnut.ru подтвердить (DKIM/SPF) + домен для трекинга ---
UNIONE_API_KEY=
EMAIL_FROM=noreply@ahnut.ru
ADMIN_EMAIL=
SUPPORT_EMAIL=hello@ahnut.ru

# --- Подпись cookie (пароль на открытку): openssl rand -hex 32 ---
SECRET_KEY=change-me-random

# --- Внутренний конвейер web ↔ n8n ---
INTERNAL_TOKEN=change-me-random
# Пусто — генерация прямо в web (рекомендуется). n8n — по желанию (--profile n8n)
N8N_GENERATE_URL=

# --- Браузер самопроверки «Принца» на сервере в Нидерландах (deploy/nl): wss://check.ahnut.ru/<BROWSER_SECRET_PATH>
# Всё на одной машине: ws://browser:3000/ и docker compose --profile browser up -d
PLAYWRIGHT_WS=

# --- Нейросеть (одна точка доступа; сменить провайдера = поменять эти строки) ---
# OpenRouter: https://openrouter.ai/api ; через прокси в Нидерландах: https://llm.ahnut.ru/api
LLM_BASE_URL=https://openrouter.ai/api
LLM_API_KEY=
LLM_MODEL_ZAPISKA=anthropic/claude-opus-5.5
LLM_MODEL_SVIDANIE=anthropic/claude-opus-5.5
LLM_MODEL_PRINCE=anthropic/claude-opus-5.5
