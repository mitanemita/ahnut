ACME_EMAIL=you@example.com
# Поддомены ahnut.ru с A-записью на IP этого сервера
CHECK_DOMAIN=check.ahnut.ru
LLM_DOMAIN=llm.ahnut.ru
# IP российского сервера (Hostkey) — только ему разрешён доступ
RU_SERVER_IP=0.0.0.0
# Секретный путь браузера: openssl rand -hex 16
BROWSER_SECRET_PATH=change-me
# Если 80/443 на этом сервере уже заняты — см. docs/DEPLOY.md, раздел про Нидерланды
HTTP_PORT=80
HTTPS_PORT=443
